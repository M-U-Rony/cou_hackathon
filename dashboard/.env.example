# Copy to .env.local for local dev (npm run dev), or add these in
# Vercel > Project > Settings > Environment Variables. Never commit real keys.
# Everything works without them: the app then shows the template summary and
# uses the browser's own Bangla voice, if the device has one.

# AI Bangla summary — Recommended: OpenRouter (multi-model auto-fallback:
# google/gemini-2.5-flash -> anthropic/claude-haiku-4.5 -> openai/gpt-4o-mini)
OPENROUTER_API_KEY=
# Alternative direct Anthropic Claude key
ANTHROPIC_API_KEY=
# LLM_MODEL=google/gemini-2.5-flash

# Server voice (ElevenLabs). Voice id: any voice in your ElevenLabs library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# HMAC-SHA256 signing secret for optional account session cookies (/api/auth).
# Set a strong 32+ char random string in Vercel Project Settings for production.
AUTH_SECRET=
